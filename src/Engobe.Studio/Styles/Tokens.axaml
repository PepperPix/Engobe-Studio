<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==========================================
         Ember Design Language — Token Palette
         ADR-031: Dark-First, 4-px Grid, Inter
         ========================================== -->
    <Styles.Resources>

        <!-- Colour palette — raw Colors -->
        <Color x:Key="EngobeBackgroundColor">#1E1B18</Color>
        <Color x:Key="EngobeSurfaceColor">#272320</Color>
        <Color x:Key="EngobeSurfaceAltColor">#312B27</Color>
        <Color x:Key="EngobeBorderColor">#3A332E</Color>
        <Color x:Key="EngobeTextColor">#EDE8E2</Color>
        <Color x:Key="EngobeTextMutedColor">#A89F97</Color>
        <Color x:Key="EngobePrimaryColor">#E2622B</Color>
        <Color x:Key="EngobePrimaryHoverColor">#F0743B</Color>
        <Color x:Key="EngobePrimaryMutedColor">#7A3A1C</Color>
        <Color x:Key="EngobeSuccessColor">#5FA85A</Color>
        <Color x:Key="EngobeWarnColor">#D9A441</Color>
        <Color x:Key="EngobeErrorColor">#D9534F</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="EngobeBackgroundBrush" Color="{StaticResource EngobeBackgroundColor}" />
        <SolidColorBrush x:Key="EngobeSurfaceBrush" Color="{StaticResource EngobeSurfaceColor}" />
        <SolidColorBrush x:Key="EngobeSurfaceAltBrush" Color="{StaticResource EngobeSurfaceAltColor}" />
        <SolidColorBrush x:Key="EngobeBorderBrush" Color="{StaticResource EngobeBorderColor}" />
        <SolidColorBrush x:Key="EngobeTextBrush" Color="{StaticResource EngobeTextColor}" />
        <SolidColorBrush x:Key="EngobeTextMutedBrush" Color="{StaticResource EngobeTextMutedColor}" />
        <SolidColorBrush x:Key="EngobePrimaryBrush" Color="{StaticResource EngobePrimaryColor}" />
        <SolidColorBrush x:Key="EngobePrimaryHoverBrush" Color="{StaticResource EngobePrimaryHoverColor}" />
        <SolidColorBrush x:Key="EngobePrimaryMutedBrush" Color="{StaticResource EngobePrimaryMutedColor}" />
        <SolidColorBrush x:Key="EngobeSuccessBrush" Color="{StaticResource EngobeSuccessColor}" />
        <SolidColorBrush x:Key="EngobeWarnBrush" Color="{StaticResource EngobeWarnColor}" />
        <SolidColorBrush x:Key="EngobeErrorBrush" Color="{StaticResource EngobeErrorColor}" />
        <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

        <!-- Spacing (4-px grid) -->
        <x:Double x:Key="SpacingXS">4</x:Double>
        <x:Double x:Key="SpacingS">8</x:Double>
        <x:Double x:Key="SpacingM">12</x:Double>
        <x:Double x:Key="SpacingL">16</x:Double>
        <x:Double x:Key="SpacingXL">24</x:Double>

        <!-- Typography -->
        <x:Double x:Key="FontSizeXS">12</x:Double>
        <x:Double x:Key="FontSizeS">12</x:Double>
        <x:Double x:Key="FontSizeM">14</x:Double>
        <x:Double x:Key="FontSizeBase">14</x:Double>
        <x:Double x:Key="FontSizeL">16</x:Double>
        <x:Double x:Key="FontSizeXL">18</x:Double>
        <x:Double x:Key="FontSizeH">24</x:Double>

        <!-- Code typography -->
        <FontFamily x:Key="EngobeCodeFontFamily">avares://Engobe.Studio/Assets/Fonts/JetBrainsMono#JetBrains Mono Light</FontFamily>

        <!-- Corner radii -->
        <CornerRadius x:Key="CornerRadiusControl">6</CornerRadius>
        <CornerRadius x:Key="CornerRadiusCard">10</CornerRadius>

        <!-- Composite tokens -->
        <Thickness x:Key="ToolbarPadding">12,10</Thickness>
        <Thickness x:Key="StatusPadding">10,6</Thickness>
        <Thickness x:Key="ButtonPadding">12,8</Thickness>
        <Thickness x:Key="PanelMargin">8</Thickness>
        <Thickness x:Key="DialogMargin">16</Thickness>
        <x:Double x:Key="ToolbarHeight">40</x:Double>
        <x:Double x:Key="RowHeight">28</x:Double>

    </Styles.Resources>

    <!-- Base window / text -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource EngobeBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource EngobeTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>

    <Style Selector="UserControl">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
    </Style>

    <!-- Structural region borders -->
    <Style Selector="Border.toolbar-host">
        <Setter Property="Background" Value="{StaticResource EngobeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EngobeBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{StaticResource ToolbarPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource ToolbarHeight}" />
    </Style>

    <Style Selector="Border.status-host">
        <Setter Property="Background" Value="{StaticResource EngobeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EngobeBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource StatusPadding}" />
    </Style>

    <Style Selector="Border.preview-status-host">
        <Setter Property="Background" Value="{StaticResource EngobeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource EngobeBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style Selector="Border.settings-section">
        <Setter Property="BorderBrush" Value="{StaticResource EngobeBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,8,0,0" />
    </Style>

    <!-- TextBlock helpers -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource EngobeTextMutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
    </Style>

    <Style Selector="TextBlock.section-header">
        <Setter Property="Foreground" Value="{StaticResource EngobeTextMutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style Selector="TextBlock.status-text">
        <Setter Property="Foreground" Value="{StaticResource EngobeTextMutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
    </Style>

    <!-- Progress bar -->
    <Style Selector="ProgressBar.busy-indicator">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource EngobePrimaryBrush}" />
    </Style>

</Styles>